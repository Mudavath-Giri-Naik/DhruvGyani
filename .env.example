# Copy to .env.local and fill in. Never commit .env.local.
# Leave everything blank to run on the bundled demo store (sample data, demo personas).

# Public URL of the site (used for RSS links and OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API: Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys: publishable key (sb_publishable_…). Legacy "anon" key also works via NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase → Project Settings → API Keys: secret key (sb_secret_…). SERVER ONLY — never expose. Legacy "service_role" works via SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=
# Optional: Supabase → Connect → Session pooler connection string, for `npm run db:migrate` / `db:seed`
SUPABASE_DB_URL=

# LLM provider for the Content Studio, explainers and Ask NCPOR (currently: gemini)
LLM_PROVIDER=gemini
# Google AI Studio → Get API key
GEMINI_API_KEY=
# Fast, low-cost text model (default: gemini-flash-latest)
LLM_MODEL=gemini-flash-latest
# Embedding model (default: gemini-embedding-2)
EMBEDDING_MODEL=gemini-embedding-2
# Must equal EMBEDDING_DIM in src/lib/constants.ts and vector(768) in the migration
EMBEDDING_DIM=768

# Comma-separated Google account emails that become admins on first sign-in / `npm run seed:admin`
ADMIN_BOOTSTRAP_EMAILS=
# true = never call the LLM; serve pre-generated demo content instead
DEMO_MODE=false
